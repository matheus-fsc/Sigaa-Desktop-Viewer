  <action name="acAtualizar">
   <property name="text">
    <string>Atualizar</string>
   </property>
   <property name="toolTip">
    <string>Consulta o portal: atividades e avisos. Uma requisição, poucos segundos.</string>
   </property>
  </action>
  <action name="acAtualizarTudo">
   <property name="text">
    <string>Atualizar tudo</string>
   </property>
   <property name="toolTip">
    <string>Entra em cada turma para buscar provas e tópicos. ~15 requisições, cerca de meio minuto.</string>
   </property>
  </action>
  <action name="acRelatorio">
   <property name="enabled">
    <bool>false</bool>
   </property>
   <property name="text">
    <string>Abrir relatório</string>
   </property>
