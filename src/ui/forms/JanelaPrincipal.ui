    <string>Abre no navegador o relatório HTML gerado no último sync.</string>
   </property>
  </action>
  <action name="acDiagnostico">
   <property name="text">
    <string>Diagnóstico</string>
   </property>
   <property name="toolTip">
    <string>Mostra todas as requisições feitas ao SIGAA, ao vivo: ritmo, repetições e o que o servidor respondeu. É onde se vê um laço antes de ele virar bloqueio de conta.</string>
   </property>
  </action>
  <action name="acAuto">
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="text">
    <string>Automático</string>
   </property>
  </action>
