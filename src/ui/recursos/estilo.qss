/* ---------------------------------------------------------------------------
 * Folha de estilo do sigaa-ui.  Carregada por ui/Tema.cpp a partir do .qrc.
 *
 * REGRA DESTE ARQUIVO: nenhuma cor literal.  Toda cor e um TOKEN — `@surface`,
 * `@line-strong`, `@accent-fill` — com os mesmos nomes do design system das
 * telas de referencia.  tema::aplicar troca cada `@nome` pela cor do tema em
 * vigor (claro ou escuro) antes de entregar a folha ao Qt; a tabela de cores
 * mora em Tema.cpp e so la.
 *
 * Consequencia pratica: cravar um "#3d6fd6" aqui nao so quebraria o tema claro
 * como sairia do ar na hora em que o azul do app mudasse.  Um token com erro
 * de digitacao vira aviso no console ("tema: token desconhecido").
 *
 * TAMBEM NAO HA "font-size" AQUI.  Tamanho de fonte sai de tema::fonte(), que
 * deriva da fonte do sistema; um "10pt" cravado ignoraria a escala de
 * acessibilidade de quem aumentou a fonte no Windows para enxergar.
 *
 * Espacamento segue o ritmo de 4px de tema::esp().  Raios: 8px em controle,
 * 10px em lista e cartao, 999 (pilula) nao existe em QSS — use metade da
 * altura.
 * ------------------------------------------------------------------------- */

/* --- Base ---------------------------------------------------------------- */

QMainWindow,
QDialog {
    background: @bg;
}

/* O Fusion desenha uma moldura afundada em volta de area de rolagem.  E o
 * detalhe que mais data a aparencia de um app Qt: caixa dentro de caixa dentro
 * de caixa.  Quem precisa de moldura (as listas) declara a sua, abaixo. */
QAbstractScrollArea {
    border: none;
}

QLabel {
    background: transparent;
}

/* --- Barra de acoes ------------------------------------------------------ */

/* O cabecalho do prototipo (SIGAA Web.dc.html), numa linha: abas
 * (ui/Cabecalho.cpp) e as acoes a direita.  Fundo de superficie, filete
 * embaixo.  Altura (56) e respiro lateral (20) ficam em
 * JanelaPrincipal::montarAcoes: aqui eles pintariam sem mover os itens. */
QToolBar#barraAcoes {
    border: none;
    border-bottom: 1px solid @line;
    background: @surface;
    spacing: 8px;
}

/* Botoes de 34px: 32 de conteudo + a borda.  Discretos (sem moldura) por
 * padrao — "Entrar no SIGAA" e "Opcoes"; `Atualizar tudo` e secundario,
 * `Atualizar` e o UNICO primario e `Conta` e a pilula com avatar.  Quem marca
 * cada um e JanelaPrincipal::montarAcoes. */
QToolBar#barraAcoes QToolButton {
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 0 12px;
    min-height: 32px;
    background: transparent;
    color: @text-2;
    font-weight: 600;
}

QToolBar#barraAcoes QToolButton:hover {
    background: @surface-2;
    color: @text;
}

QToolBar#barraAcoes QToolButton:pressed {
    background: @surface-3;
}

QToolBar#barraAcoes QToolButton[papel="secundario"] {
    background: @surface;
    border-color: @line-strong;
    color: @text;
}

QToolBar#barraAcoes QToolButton[papel="secundario"]:hover {
    background: @surface-2;
}

QToolBar#barraAcoes QToolButton[papel="primario"] {
    background: @accent-fill;
    border-color: @accent-fill;
    color: @on-accent;
    padding: 0 14px;
    font-weight: bold;
}

QToolBar#barraAcoes QToolButton[papel="primario"]:hover {
    background: @accent-fill-hover;
    border-color: @accent-fill-hover;
}

/* Pilula da conta: avatar de 26px encostado a esquerda (4px), "Conta" e a
 * setinha do menu a direita. */
QToolBar#barraAcoes QToolButton[papel="conta"] {
    border-color: @line;
    border-radius: 17px;
    padding: 0 24px 0 4px;
    color: @text;
}

QToolBar#barraAcoes QToolButton[papel="conta"]::menu-indicator {
    image: @seta-baixo-texto;
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 8px;
    height: 6px;
    right: 10px;
}

QToolBar#barraAcoes QToolButton:disabled,
QToolBar#barraAcoes QToolButton[papel="primario"]:disabled {
    background: @surface-2;
    border-color: @line;
    color: @text-off;
}

/* Ligado ("Automatico").  O icone tem uma variante On tingida com
 * highlighted-text em Icones.cpp — sem ela o desenho sumiria contra o azul. */
QToolBar#barraAcoes QToolButton:checked {
    background: @accent-fill;
    color: @on-accent;
    border-color: @accent-fill;
}

QToolBar#barraAcoes QToolButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 4px;
}

QToolBar::separator {
    background: @line;
    width: 1px;
    margin: 6px 4px;
}

/* --- Abas ---------------------------------------------------------------- */

QTabWidget::pane {
    border: none;
    border-top: 1px solid @line;
}

/* As abas da janela principal moram no cabecalho (ui/Cabecalho.cpp); o
 * QTabWidget dela fica so com as paginas, sem filete — o do cabecalho basta. */
QTabWidget#abas::pane {
    border: none;
}

QTabWidget::tab-bar {
    left: 12px;
}

/* Sublinhado no lugar de "aba fisica": a contagem no titulo ("Prazos (12)")
 * ja muda de largura a cada sync, e moldura sombreada so soma ruido. */
QTabBar::tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 10px 14px;
    margin-right: 4px;
    color: @text-2;
}

QTabBar::tab:hover {
    color: @text;
}

QTabBar::tab:selected {
    color: @text;
    font-weight: bold;
    border-bottom-color: @accent;
}

/* --- Botoes -------------------------------------------------------------- */

/* Secundario e o padrao: moldura forte, fundo de superficie. */
QPushButton,
QToolButton {
    background: @surface;
    border: 1px solid @line-strong;
    border-radius: 8px;
    padding: 6px 14px;
    color: @text;
}

QPushButton:hover,
QToolButton:hover {
    background: @surface-2;
}

QPushButton:pressed,
QToolButton:pressed {
    background: @surface-3;
}

QPushButton:disabled,
QToolButton:disabled {
    background: @surface-2;
    border-color: @line;
    color: @text-off;
}

QToolButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 4px;
}

/* A acao principal do dialogo.  O Qt marca sozinho o botao Default, entao isto
 * pega "Entrar" e "Baixar" sem ninguem precisar etiquetar nada no .ui. */
QPushButton:default {
    background: @accent-fill;
    border-color: @accent-fill;
    color: @on-accent;
    font-weight: bold;
}

QPushButton:default:hover {
    background: @accent-fill-hover;
    border-color: @accent-fill-hover;
}

QPushButton:default:disabled {
    background: @surface-2;
    border-color: @line;
    color: @text-off;
}

/* Foco visivel, e visivel de longe.  E acessibilidade antes de ser estetica:
 * quem navega por Tab precisa saber onde esta. */
QPushButton:focus,
QToolButton:focus {
    border-color: @focus;
}

/* Navegacao da semana na Agenda: setas quadradas (32px, fixadas em C++) e o
 * "Hoje", com o canto de 7px e o cinza de apoio da referencia. */
QToolButton#botaoSemanaAnterior,
QToolButton#botaoSemanaSeguinte {
    padding: 0;
    border-radius: 7px;
    color: @text-2;
}

QToolButton#botaoSemanaAnterior:hover,
QToolButton#botaoSemanaSeguinte:hover {
    color: @text;
}

/* Setas e "Periodo inteiro" da carga por semana: pequenos, no titulo da
 * coluna, para nao competir com o grafico. */
QToolButton#setaCarga {
    padding: 0;
    border-radius: 6px;
    color: @text-2;
    font-weight: bold;
}

QToolButton#setaCarga:hover {
    color: @text;
}

QToolButton#botaoCargaCompleta {
    padding: 2px 10px;
    border-radius: 6px;
    color: @text-2;
}

QToolButton#botaoCargaCompleta:hover {
    color: @text;
}

QToolButton#botaoHoje {
    padding: 0 12px;
    border-radius: 7px;
    font-weight: 600;
}

QLabel#rotuloResumoDia {
    color: @text-2;
}

/* --- Campos -------------------------------------------------------------- */

/* SEM PADDING VERTICAL, e sem `min-height`.  Os dois foram tentados e os dois
 * quebraram, de formas diferentes:
 *
 *   - `padding: 7px` sozinho: o Qt calcula a altura natural do campo SEM o
 *     padding desta folha, o campo nasce curto demais para o proprio texto, e
 *     o QComboBox desenhava a fatia de cima das letras e cortava o resto.
 *   - `padding` + `min-height`: o desenho cresce, o `sizeHint` NAO, e o layout
 *     aloca a altura antiga — as duas linhas do formulario se sobrepunham, com
 *     os combos por cima dos proprios rotulos.
 *
 * E a mesma armadilha do padding de celula em QTableView (ver
 * tema::kRespiroCelula): o QSS pinta, o C++ mede, e os dois nao se falam.  A
 * altura vertical fica com o Qt, que sabe medi-la; daqui sai so o respiro
 * HORIZONTAL, que nao afeta o empilhamento das linhas.
 */
QLineEdit,
QSpinBox,
QDateTimeEdit,
QPlainTextEdit,
QTextEdit {
    background: @bg;
    border: 1px solid @line-strong;
    border-radius: 8px;
    padding-left: 10px;
    padding-right: 10px;
    color: @text;
    selection-background-color: @accent-fill;
    selection-color: @on-accent;
}

QLineEdit:focus,
QSpinBox:focus,
QDateTimeEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus {
    border-color: @focus;
}

QLineEdit:disabled,
QSpinBox:disabled,
QDateTimeEdit:disabled {
    background: @surface-2;
    color: @text-off;
}

/* O QComboBox NAO e estilizado, e a ausencia custou tres tentativas:
 *
 *   1. `padding: 7px 10px` — o Qt mede a altura natural SEM o padding do QSS,
 *      o campo nasceu curto demais e o texto saiu cortado pela metade.
 *   2. `padding` + `min-height` — o desenho cresceu, o `sizeHint` nao, e as
 *      linhas do formulario passaram a se sobrepor, com os combos por cima
 *      dos proprios rotulos.
 *   3. so `padding-left/right` — o campo colapsou para uma fatia de poucos
 *      pixels.
 *
 * A raiz e conhecida: estilizar um QComboBox transfere a GEOMETRIA dele para o
 * QStyleSheetStyle, e a partir dai a regra tem de descrever tudo — moldura,
 * respiro, seta, altura — ou o que faltar vira zero.  Descrever tudo significa
 * tambem embutir a imagem da seta, porque `::down-arrow` sem `image` some.
 *
 * O preco de deixar o Fusion desenhar e um canto menos arredondado que o dos
 * outros campos.  A paleta do tema continua valendo: as cores saem dela.
 */

/* A lista que desce do combo e uma janela separada: sem estas regras ela abre
 * com a moldura crua do Fusion, destoando do campo que a abriu. */
QComboBox QAbstractItemView {
    background: @surface;
    border: 1px solid @line-strong;
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: @accent-soft;
    selection-color: @text;
}

/* Grupos das Opcoes e dos dialogos: cartao com titulo de secao, sem a moldura
 * afundada do Fusion. */
QGroupBox {
    background: @surface;
    border: 1px solid @line;
    border-radius: 10px;
    margin-top: 22px;
    padding: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 2px;
    top: 0;
    padding: 0 2px;
    color: @text-3;
}

/* --- Listas e tabelas ---------------------------------------------------- */

/* A lista e um cartao: superficie, filete e canto de 10px, como no prototipo.
 * O raio fica em 8 e nao em 10 porque o viewport do Qt e retangular e so
 * recua a espessura da borda — num raio maior, o canto dele aparece por fora
 * da curva. */
QTableView,
QTreeView {
    background: @surface;
    border: 1px solid @line;
    border-radius: 8px;
    /* Sem grade.  A separacao entre linhas vem do filete de ::item; a grade
     * completa e o que faz uma lista parecer planilha de contabilidade. */
    gridline-color: transparent;
    selection-background-color: @accent-soft;
    selection-color: @text;
    alternate-background-color: @surface;
    outline: none;
}

/* O respiro horizontal (10px) esta DUPLICADO em tema::kRespiroCelula, e tem de
 * continuar batendo: o Qt nao conta o padding do QSS ao medir a largura de uma
 * coluna, entao e o C++ que soma a diferenca de volta.  Mudar um lado sozinho
 * corta a ultima palavra das colunas. */
QTableView::item,
QTreeView::item {
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid @line;
}

/* Na arvore, a coluna de setinhas e um subcontrole a parte: sem o mesmo
 * filete, a linha divisoria comecaria recuada, depois da seta. */
QTreeView::branch {
    border-bottom: 1px solid @line;
}

/* Linha de grupo (dia da agenda, "Prazos atuais", aula com materiais): um
 * degrau de superficie acima, como o cabecalho de grupo do prototipo. */
QTreeView::item:has-children,
QTreeView::branch:has-children {
    background: @surface-2;
}

/* Linha inteira sob o cursor: a tabela de prazos e larga, e sem isto o olho
 * perde a linha no meio do caminho entre a turma e a data. */
QTableView::item:hover,
QTreeView::item:hover {
    background: @surface-2;
}

QTableView::item:selected,
QTreeView::item:selected,
QTreeView::branch:selected {
    background: @accent-soft;
    color: @text;
}

/* Setas de abrir/fechar grupo.  Sem estas imagens o QSS de ::branch acima
 * apagaria as do Fusion. */
QTreeView::branch:has-children:closed {
    image: @seta-direita;
}

QTreeView::branch:has-children:open {
    image: @seta-baixo;
}

/* Cabecalho plano, rotulo em caixa-alta (a fonte vem de tema::ajustarLista).
 *
 * Estilizar ::section passa o cabecalho INTEIRO para o QSS, e a seta de
 * ordenacao so aparece se a folha disser qual imagem usar — as setas sao
 * geradas por Tema.cpp na cor do tema.  Sem elas as tabelas, todas
 * ordenaveis, perderiam a unica pista de por qual coluna estao ordenadas. */
QHeaderView {
    background: @surface-2;
    border: none;
}

QHeaderView::section {
    background: @surface-2;
    color: @text-3;
    border: none;
    border-bottom: 1px solid @line;
    padding: 8px 10px;
}

QHeaderView::up-arrow {
    image: @seta-cima;
    subcontrol-position: center right;
    width: 10px;
    height: 8px;
    right: 8px;
}

QHeaderView::down-arrow {
    image: @seta-baixo;
    subcontrol-position: center right;
    width: 10px;
    height: 8px;
    right: 8px;
}

QTableCornerButton::section {
    background: @surface-2;
    border: none;
}

/* QCalendarWidget tem uma QTableView POR DENTRO (QCalendarView herda de
 * QTableView), entao as regras acima caem nela sem ninguem pedir: o padding de
 * ::item incha cada celula do mes, a moldura de cartao vira caixa dentro de
 * caixa e o filete risca a grade.  Desfaz so para o calendario. */
QCalendarWidget QTableView {
    border: none;
    border-radius: 0;
    background: @surface;
    selection-background-color: @accent-soft;
    selection-color: @text;
}

QCalendarWidget QTableView::item {
    padding: 0;
    border: none;
}

QCalendarWidget QTableView::item:hover {
    background: transparent;
}

QCalendarWidget QTableView::item:selected {
    background: @accent-soft;
    color: @text;
}

/* Barra de navegacao do mes: o Fusion pinta de Highlight (azul cheio), que no
 * prototipo e so para a acao principal. */
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background: @surface;
    border-bottom: 1px solid @line;
    padding: 4px;
}

QCalendarWidget QToolButton {
    background: transparent;
    border: 1px solid transparent;
    color: @text;
    font-weight: bold;
    padding: 4px 8px;
}

QCalendarWidget QToolButton:hover {
    background: @surface-2;
    border-color: @line-strong;
}

QCalendarWidget QToolButton#qt_calendar_prevmonth,
QCalendarWidget QToolButton#qt_calendar_nextmonth {
    border-color: @line-strong;
    min-width: 24px;
}

QCalendarWidget QToolButton::menu-indicator {
    image: none;
    width: 0;
}

QCalendarWidget QSpinBox {
    background: @surface;
    border: 1px solid @line-strong;
}

/* --- Rolagem ------------------------------------------------------------- */

/* Barra fina, sem setas nas pontas.  As setas sao alvo pequeno demais para o
 * mouse e ninguem as usa desde que existe roda. */
QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: @line-strong;
    border-radius: 4px;
    border: 3px solid transparent;
}

QScrollBar::handle:vertical {
    min-height: 32px;
}

QScrollBar::handle:horizontal {
    min-width: 32px;
}

QScrollBar::handle:hover {
    background: @text-3;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    height: 0;
    width: 0;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}

/* --- Divisor ------------------------------------------------------------- */

/* A alca pontilhada do Fusion entre Agenda e Prazos era o unico enfeite
 * "de sistema" que sobrava na tela.  Vira so espaco — o cursor ainda muda. */
QSplitter::handle {
    background: transparent;
}

/* --- Dashboard de provas ------------------------------------------------- */

/* Cartao de resumo.  So chrome: fundo, borda e respiro.  O tamanho de fonte
 * fica em JanelaPrincipal.cpp, porque um "font-size" cravado aqui ignoraria a
 * escala do sistema. */
QFrame[classe="cartao"] {
    background: @surface;
    border: 1px solid @line;
    border-radius: 10px;
}

/* O painel de resumo e UM cartao com duas colunas; o filete entre elas e um
 * QFrame de 1px pintado aqui. */
QFrame#fileteVertical {
    background: @line;
    border: none;
    margin: 16px 0;
}

/* --- Pilulas ------------------------------------------------------------- */

/* Aviso pequeno que exige acao ("○ 8 datas a confirmar"): tinta de estado
 * sobre o "soft" dela, como as pilulas das tabelas. */
QToolButton[classe="pilulaAviso"] {
    background: @warn-soft;
    color: @warn;
    border: 1px solid transparent;
    border-radius: 11px;
    padding: 2px 10px;
    font-weight: bold;
}

/* Clicavel (abre "Datas a confirmar"): o contorno na cor do aviso e a pista. */
QToolButton[classe="pilulaAviso"]:hover {
    border-color: @warn;
}

/* --- Datas a confirmar --------------------------------------------------- */

/* Linhas separadas por filete, como as das listas. */
QFrame#linhaConfirmar {
    border: none;
    border-bottom: 1px solid @line;
}

QWidget#listaConfirmar {
    background: transparent;
}

/* Papeis de botao dentro de listas: secundario (com moldura), discreto (sem)
 * e perigo (sem moldura, texto vermelho) — "Nao e prova" tira algo do app, e
 * precisa se distinguir de "Confirmar" sem gritar. */
QPushButton[papel="secundario"] {
    border-color: @line-strong;
}

QPushButton[papel="discreto"] {
    background: transparent;
    border-color: transparent;
    color: @text-2;
}

QPushButton[papel="discreto"]:hover {
    background: @surface-2;
    color: @text;
}

QPushButton[papel="perigo"] {
    background: transparent;
    border-color: transparent;
    color: @danger;
}

QPushButton[papel="perigo"]:hover {
    background: @danger-soft;
}

/* Texto da noticia, dentro do cartao: sem moldura e sem fundo proprio, para
 * ler como parte do cartao e nao como uma caixa dentro dele. */
QTextBrowser#textoNoticia {
    background: transparent;
    border: none;
    color: @text;
}

/* --- Progresso ----------------------------------------------------------- */

QProgressBar {
    background: @surface-3;
    border: none;
    border-radius: 3px;
    max-height: 6px;
    text-align: center;
}

QProgressBar::chunk {
    background: @accent-fill;
    border-radius: 3px;
}

/* --- Barra de status ----------------------------------------------------- */

QStatusBar {
    border-top: 1px solid @line;
    background: @surface;
    color: @text-2;
}

/* Tira o entalhe que o Qt desenha em volta de cada widget da barra. */
QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    padding: 4px 8px;
    color: @text-2;
}

/* --- Menus e dicas ------------------------------------------------------- */

QMenu {
    background: @surface;
    border: 1px solid @line-strong;
    border-radius: 10px;
    padding: 4px;
    color: @text;
}

QMenu::item {
    padding: 7px 24px 7px 12px;
    border-radius: 6px;
}

QMenu::item:selected {
    background: @accent-soft;
    color: @text;
}

QMenu::item:disabled {
    color: @text-off;
}

QMenu::separator {
    height: 1px;
    background: @line;
    margin: 4px 8px;
}

QToolTip {
    background: @tooltip;
    color: @on-tooltip;
    border: none;
    border-radius: 6px;
    padding: 6px 8px;
}

/* --- Caixas de marcar ---------------------------------------------------- */

/* Marcada = acao azul com o visto branco, como no prototipo.  A imagem do
 * visto e gerada por Tema.cpp, pela mesma razao das setas. */
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid @line-strong;
    background: @bg;
}

QCheckBox::indicator:hover {
    border-color: @accent;
}

QCheckBox::indicator:checked {
    background: @accent-fill;
    border-color: @accent-fill;
    image: @visto;
}

QCheckBox::indicator:disabled {
    background: @surface-2;
    border-color: @line;
}

QCheckBox::indicator:checked:disabled {
    background: @surface-3;
    border-color: @surface-3;
}

QCheckBox:disabled {
    color: @text-off;
}

/* --- Rotulos com papel --------------------------------------------------- */

QLabel[classe="titulo"] {
    font-weight: bold;
}

/* Rotulo de secao do design system ("AULAS", "PRAZOS"): negrito, caixa-alta
 * e tamanho vem do C++; aqui so a cor.  NADA de `font-weight` aqui: qualquer
 * propriedade de fonte no QSS remonta a fonte do rotulo e a caixa-alta some. */
QLabel[classe="secao"] {
    color: @text-3;
}

/* Recado neutro: o que vai acontecer, sem alarme. */
QLabel[classe="recado"] {
    background: @surface-2;
    border: 1px solid @line;
    border-radius: 10px;
    padding: 10px 12px;
    color: @text;
}

/* Aviso de consequencia ("3 senhas erradas bloqueiam a conta"). */
QLabel[classe="alerta"] {
    background: @warn-soft;
    border: none;
    border-radius: 10px;
    padding: 10px 12px;
    color: @text;
}

/* Notas cinzas.  Antes isto era feito em C++ (esmaecer) porque o QSS nao
 * enxerga palette(placeholder-text); com tokens a cor tem nome. */
QLabel[classe="nota"] {
    color: @text-3;
}

/* --- Menu lateral da aba Estudo ------------------------------------------ */

QListWidget#menuEstudo {
    background: @surface;
    border: none;
    padding: 16px 10px;
    outline: none;
}

QListWidget#menuEstudo::item {
    padding: 9px 12px;
    margin: 1px 0;
    border-radius: 8px;
    color: @text-2;
}

QListWidget#menuEstudo::item:hover {
    background: @surface-2;
    color: @text;
}

QListWidget#menuEstudo::item:selected {
    background: @accent-soft;
    color: @accent;
}

/* --- Controles da aba Estudo (ui/Controles.h) ---------------------------- */

/* O primario fora da barra de acoes: "Aceitar", "Conectar um agente". */
QPushButton[papel="primario"] {
    background: @accent-fill;
    border-color: @accent-fill;
    color: @on-accent;
    font-weight: bold;
}

QPushButton[papel="primario"]:hover {
    background: @accent-fill-hover;
    border-color: @accent-fill-hover;
}

QPushButton[papel="primario"]:disabled {
    background: @surface-2;
    border-color: @line;
    color: @text-off;
}

/* Link: "Desfazer", "Ver proposta", "Alterar o que ele pode mudar". */
QPushButton[papel="link"] {
    background: transparent;
    border: none;
    padding: 2px 4px;
    color: @accent;
}

QPushButton[papel="link"]:hover {
    color: @text;
}

/* Seletor segmentado: uma moldura so, e um filete entre as opcoes. */
QWidget#segmentado {
    background: @surface;
    border: 1px solid @line-strong;
    border-radius: 8px;
}

QWidget#segmentado QPushButton {
    background: transparent;
    border: none;
    border-left: 1px solid @line-strong;
    border-radius: 0;
    padding: 6px 12px;
    color: @text;
}

QWidget#segmentado QPushButton[pos="primeiro"] {
    border-left: none;
    border-top-left-radius: 7px;
    border-bottom-left-radius: 7px;
}

QWidget#segmentado QPushButton[pos="ultimo"] {
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
}

QWidget#segmentado QPushButton:hover {
    background: @surface-2;
}

QWidget#segmentado QPushButton:checked {
    background: @accent-soft;
    color: @accent;
}

QWidget#segmentado QPushButton:disabled {
    color: @text-off;
}

/* Passo  - valor +: o valor no meio, sobre o fundo da janela. */
QWidget#passo {
    background: @bg;
    border: 1px solid @line-strong;
    border-radius: 8px;
}

QWidget#passo QPushButton {
    background: transparent;
    border: none;
    border-radius: 7px;
    padding: 0;
    color: @text;
}

QWidget#passo QPushButton:hover {
    background: @surface-2;
}

QWidget#passo QPushButton:disabled {
    color: @text-off;
}

/* Pilulas de texto: "- pelo agente", "2 esperando voce". */
QLabel[classe="pilula"] {
    border: 1px solid transparent;
    /* Ate metade da altura: um raio maior o Qt ignora, e a pilula sai reta. */
    border-radius: 8px;
    padding: 1px 9px;
}

QLabel[classe="pilula"][tom="acento"] {
    background: @accent-soft;
    color: @accent;
}

QLabel[classe="pilula"][tom="aviso"] {
    background: @warn-soft;
    color: @warn;
}

QLabel[classe="pilula"][tom="ok"] {
    background: @ok-soft;
    color: @ok;
}

QLabel[classe="pilula"][tom="perigo"] {
    background: @danger-soft;
    color: @danger;
}

/* Topico de prova: cinza, sem alarme. */
QLabel[classe="pilula"][tom="neutro"] {
    background: @surface-2;
    color: @text-2;
    border-radius: 6px;
}

/* --- Planejamento -------------------------------------------------------- */

/* Icone quadrado de 24 px num item do checklist: entrega, confirmar, estudo. */
QLabel[classe="icone"] {
    border-radius: 6px;
}

QLabel[classe="icone"][tom="aviso"] {
    background: @warn-soft;
    color: @warn;
}

QLabel[classe="icone"][tom="perigo"] {
    background: @danger-soft;
    color: @danger;
}

QLabel[classe="icone"][tom="acento"] {
    background: @accent-soft;
    color: @accent;
}

/* A caixa de marcar uma sessao: o visto em verde sobre o verde suave. */
QPushButton[papel="caixa"] {
    background: transparent;
    border: 2px solid @line-strong;
    border-radius: 6px;
    padding: 0;
    color: @ok;
}

QPushButton[papel="caixa"]:checked {
    background: @ok-soft;
    border-color: @ok;
}

/* Uma sessao de outro dia: chip que se marca com um clique. */
QPushButton[papel="chip"] {
    background: @surface;
    border: 1px solid @line-strong;
    border-radius: 8px;
    padding: 5px 10px;
    color: @text;
}

QPushButton[papel="chip"]:checked {
    background: @ok-soft;
    color: @text-3;
}

/* Materia na legenda do grafico: clique isola. */
QPushButton[papel="pilulaMateria"] {
    background: transparent;
    border: 1px solid @line-strong;
    border-radius: 8px;
    padding: 3px 10px;
}

QPushButton[papel="pilulaMateria"]:checked {
    background: @surface-2;
    border: 2px solid @text;
}

/* Cabecalho de grupo do "O que fazer": abre e fecha. */
QPushButton[papel="grupo"] {
    background: @surface-2;
    border: none;
    border-top: 1px solid @line;
    border-radius: 0;
    padding: 0;
    text-align: left;
}

QPushButton[papel="grupo"][tom="perigo"] {
    background: @danger-soft;
}

QPushButton[papel="grupo"]:hover {
    background: @surface-3;
}

/* Linha de lista com o filete EM CIMA: a primeira encosta no cabecalho. */
QFrame[classe="linhaTopo"] {
    background: transparent;
    border: none;
    border-top: 1px solid @line;
}

/* A semana escolhida no grafico, no topo do checklist. */
QFrame[classe="faixaAcento"] {
    background: @accent-soft;
    border: none;
    border-top: 1px solid @line;
}

/* Cartoes da aba Estudo: o forte pede resposta (proposta pendente); o
 * apagado ja foi respondido. */
QFrame[classe="cartaoForte"] {
    background: @surface;
    border: 1px solid @line-strong;
    border-radius: 10px;
}

QFrame[classe="cartaoApagado"] {
    background: @surface-2;
    border: 1px solid @line;
    border-radius: 10px;
}

/* Faixa dentro de um cartao: o ajuste de uma proposta. */
QFrame[classe="faixa"] {
    background: @surface-2;
    border: none;
    border-radius: 8px;
}

/* Linhas de uma lista dentro de um cartao, separadas por filete. */
QFrame[classe="linha"] {
    background: transparent;
    border: none;
    border-bottom: 1px solid @line;
}

QFrame[classe="rodape"] {
    background: @surface-2;
    border: none;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

/* "Apagar tudo de um agente": a acao que nao volta, em vermelho suave. */
QFrame[classe="perigo"] {
    background: @danger-soft;
    border: none;
    border-radius: 10px;
}

QPushButton[papel="chipPerigo"] {
    background: @surface;
    border: 1px solid @danger;
    color: @danger;
    font-weight: bold;
}

QFrame[classe="alertaFaixa"] {
    background: @warn-soft;
    border: none;
    border-radius: 10px;
}
