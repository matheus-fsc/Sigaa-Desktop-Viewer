// Ícone do executável no Windows.
//
// O Explorer, a barra de tarefas e o alt-tab leem o ícone do RECURSO do .exe,
// não o que o app define em tempo de execução com QApplication::setWindowIcon.
// Sem este arquivo o binário fica com o ícone genérico de aplicativo, e o
// usuário que fixa o app na barra vê um retângulo branco — mesmo com a janela
// mostrando o desenho certo.
//
// ID 1: o menor ID numérico é o que o Windows usa como ícone do arquivo.
1 ICON "../../src/ui/recursos/icones/app.ico"
